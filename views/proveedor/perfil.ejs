<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Mi perfil</title>
  <link rel="stylesheet" href="/css/output.css" />
  <style>
    /* Animación popup */
    @keyframes fade-in {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fade-in 0.25s ease-out;
    }

    /* Popup centrado */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }
    .modal-box {
      background: #fff;
      border-radius: 1rem;
      padding: 2rem;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen">
  <%- include('../partials/navbar') %>

  <main class="max-w-2xl mx-auto mt-10 mb-12 px-4">
    <!-- Título estilo “Perfil profesional” -->
    <!-- <h1 class="text-3xl md:text-4xl font-bold text-blue-700 mb-6">
      Perfil profesional
    </h1> -->

    <br>
    <br>
    <!-- Caja del formulario -->
    <section class="bg-white rounded-lg shadow-md px-6 py-6 md:px-8 md:py-8">

      <!-- Mensajes -->
      <% if (mensajeOk) { %>
        <div class="mb-4 bg-green-100 text-green-700 text-sm px-4 py-3 rounded border border-green-200">
          <%= mensajeOk %>
        </div>
      <% } %>
      <% if (mensajeError) { %>
        <div class="mb-4 bg-red-100 text-red-700 text-sm px-4 py-3 rounded border border-red-200">
          <%= mensajeError %>
        </div>
      <% } %>

      <!-- Formulario: inputs uno debajo del otro -->
      <form action="/proveedor/perfil" method="POST" class="space-y-5">

        <!-- Descripción / Bio -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Descripción / Bio</label>
          <textarea name="descripcion" rows="3"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= proveedor && proveedor.descripcion ? proveedor.descripcion : '' %></textarea>
        </div>

        <!-- Años de experiencia -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Años de experiencia</label>
          <input type="number" min="0" name="experiencia"
            value="<%= proveedor && proveedor.experiencia ? proveedor.experiencia : '' %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Zona / barrio -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Zona / barrio</label>
          <input type="text" name="zona"
            value="<%= proveedor && proveedor.zona ? proveedor.zona : '' %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Teléfono -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Teléfono</label>
          <input type="text" name="telefono"
            value="<%= proveedor && proveedor.telefono ? proveedor.telefono : '' %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- WhatsApp -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">WhatsApp</label>
          <input type="text" name="whatsapp"
            value="<%= proveedor && proveedor.whatsapp ? proveedor.whatsapp : '' %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Email -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Email de contacto</label>
          <input type="email" name="emailContacto"
            value="<%= proveedor && proveedor.emailContacto ? proveedor.emailContacto : (user && user.email ? user.email : '') %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Disponibilidad -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Disponibilidad</label>
          <input type="text" name="disponibilidad"
            value="<%= proveedor && proveedor.disponibilidad ? proveedor.disponibilidad : '' %>"
            class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Acepta trueque -->
        <div class="flex items-center gap-2">
          <input id="aceptaTrueque" type="checkbox" name="aceptaTrueque"
            class="h-4 w-4 text-blue-600 border-slate-300 rounded"
            <%= proveedor && proveedor.aceptaTrueque ? 'checked' : '' %>>
          <label for="aceptaTrueque" class="text-sm text-slate-700">
            Acepto acuerdos de trueque / horas de intercambio
          </label>
        </div>

        <!-- Botones -->
        <div class="pt-4 border-t border-slate-200 flex flex-col md:flex-row md:justify-end gap-3">
          <a href="/proveedor/dashboard"
            class="px-4 py-2 text-sm border border-slate-300 rounded-md hover:bg-slate-50 text-center">
            Cancelar
          </a>
          <button type="submit"
                  class="px-4 py-2 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700 text-center">
            Actualizar datos
          </button>
        </div>
      </form>
    </section>
  </main>

  <!-- Popups -->
  <% if (mensajeOk) { %>
    <div id="popup-ok" class="modal-overlay">
      <div class="modal-box animate-fade-in">
        <div class="flex justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-green-500"
              fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-800 mb-2">¡Éxito!</h2>
        <p class="text-gray-600 mb-6"><%= mensajeOk %></p>
        <button type="button"
                onclick="cerrarPopup('popup-ok')"
                class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">
          Ok
        </button>
      </div>
    </div>
  <% } %>

  <% if (mensajeError) { %>
    <div id="popup-error" class="modal-overlay">
      <div class="modal-box animate-fade-in">
        <div class="flex justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-red-500"
              fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-800 mb-2">Error</h2>
        <p class="text-gray-600 mb-6"><%= mensajeError %></p>
        <button type="button"
                onclick="cerrarPopup('popup-error')"
                class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all">
          Cerrar
        </button>
      </div>
    </div>
  <% } %>

  <script>
    function cerrarPopup(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }
  </script>
</body>
</html>
