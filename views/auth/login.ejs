<%- include('../partials/header', { title: 'Iniciar sesión' }) %>

<h1 class="page-title">Iniciar sesión</h1>
<p class="page-subtitle">
  Accedé como proveedor o cliente para gestionar acuerdos y reseñas.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error">
      <%= errorMessage %>
    </div>
  <% } %>

  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label for="email" class="form-label">Correo electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        class="form-input"
        required
      />
    </div>

    <div class="form-group">
      <label for="password" class="form-label">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        class="form-input"
        required
      />
      <p class="form-help">Mínimo 6 caracteres.</p>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">
        Entrar
      </button>
    </div>
  </form>
</div>

<p class="text-sm">
  ¿No tenés cuenta?
  <a href="/auth/register" class="link-muted">Registrarse como proveedor</a>
  ·
  <a href="/auth/register-client" class="link-muted">Registrarse como cliente</a>
</p>

<%- include('../partials/footer') %>
