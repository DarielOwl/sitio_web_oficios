<%- include('../partials/header', { title: 'Registro de cliente' }) %>

<h1 class="page-title">Registro de cliente</h1>
<p class="page-subtitle">
  Registrate para crear acuerdos con proveedores y dejar reseñas.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error">
      <%= errorMessage %>
    </div>
  <% } %>

  <form action="/auth/register-client" method="POST">
    <div class="form-group">
      <label for="name" class="form-label">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-input"
        placeholder="Tu nombre"
      />
    </div>

    <div class="form-group">
      <label for="email" class="form-label">Correo electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        class="form-input"
        required
      />
    </div>

    <div class="form-group">
      <label for="password" class="form-label">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        class="form-input"
        minlength="6"
        required
      />
      <p class="form-help">Mínimo 6 caracteres.</p>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">
        Registrarse como cliente
      </button>
    </div>
  </form>
</div>

<p class="text-sm">
  ¿Querés registrarte como proveedor?
  <a href="/auth/register" class="link-muted">Registro de proveedor</a>
</p>

<p class="text-sm">
  ¿Ya tenés cuenta?
  <a href="/auth/login" class="link-muted">Iniciar sesión</a>
</p>

<%- include('../partials/footer') %>
