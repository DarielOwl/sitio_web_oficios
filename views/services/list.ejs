<%- include('../partials/header', { title: 'Servicios' }) %>

<h1 class="page-title">Servicios</h1>
<p class="page-subtitle">
  Buscá servicios por categoría y zona, y entrá al perfil del proveedor para acordar el trabajo.
</p>

<div class="card form-card" style="max-width:100%;">
  <form method="GET" action="/servicios">
    <div class="form-group" style="display:flex;flex-wrap:wrap;gap:12px;">
      <div style="flex:1;min-width:160px;">
        <label for="category" class="form-label">Categoría</label>
        <select id="category" name="category" class="form-select">
          <option value="">Todas</option>
          <% (categories || []).forEach(function (cat) { %>
            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>>
              <%= cat %>
            </option>
          <% }); %>
        </select>
      </div>

      <div style="flex:1;min-width:160px;">
        <label for="zone" class="form-label">Zona</label>
        <select id="zone" name="zone" class="form-select">
          <option value="">Todas</option>
          <% (zones || []).forEach(function (z) { %>
            <option value="<%= z %>" <%= selectedZone === z ? 'selected' : '' %>>
              <%= z %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Aplicar filtros</button>
      <a href="/servicios" class="link-muted">Limpiar filtros</a>
    </div>
  </form>
</div>

<div class="card">
  <% if (services && services.length > 0) { %>
    <ul class="list-clean">
      <% services.forEach(function (service) { %>
        <li class="list-item">
          <div class="text-sm">
            <strong><%= service.title %></strong>
          </div>

          <% if (service.description) { %>
            <div class="text-sm" style="margin-top:4px;">
              <%= service.description %>
            </div>
          <% } %>

          <div class="meta-row" style="margin-top:6px;">
            <% if (service.category) { %>
              <span class="meta-item">Categoría: <%= service.category %></span>
            <% } %>

            <% if (service.priceAmount !== null) { %>
              <span class="meta-item">
                Precio: <%= service.priceAmount %> <%= service.priceCurrency || '' %>
              </span>
            <% } %>

            <% if (service.exchangeHours !== null) { %>
              <span class="meta-item">
                Intercambio: <%= service.exchangeHours %> <%= service.exchangeUnit || 'horas' %>
              </span>
            <% } %>
          </div>

          <% if (service.provider) { %>
            <div class="meta-row" style="margin-top:6px;">
              <span class="meta-item">
                Proveedor:
                <a href="/proveedores/<%= service.provider.id %>" class="link-muted">
                  <%= service.provider.name %>
                </a>
              </span>

              <% if (service.provider.zone) { %>
                <span class="meta-item">Zona: <%= service.provider.zone %></span>
              <% } %>
            </div>

            <div class="meta-row" style="margin-top:4px;">
              <% if (service.provider.whatsapp) { %>
                <a
                  href="https://wa.me/<%= service.provider.whatsapp.replace(/[^0-9]/g, '') %>"
                  target="_blank"
                  class="link-muted"
                >
                  WhatsApp
                </a>
              <% } %>

              <% if (service.provider.email) { %>
                <a
                  href="mailto:<%= service.provider.email %>"
                  class="link-muted"
                  style="margin-left:12px;"
                >
                  Correo
                </a>
              <% } %>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="text-sm">
      No se encontraron servicios con los filtros seleccionados.
    </p>
  <% } %>
</div>

<p class="text-sm" style="margin-top:16px;">
  <a href="/" class="link-muted">Volver al inicio</a>
</p>

<%- include('../partials/footer') %>
