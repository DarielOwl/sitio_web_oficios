<%- include('../partials/header', { title: 'Nuevo servicio' }) %>

<h1 class="page-title">Nuevo servicio</h1>
<p class="page-subtitle">
  Cargá un servicio para que los solicitantes puedan verlo en tu perfil.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error"><%= errorMessage %></div>
  <% } %>

  <form action="/proveedores/<%= provider.id %>/servicios" method="POST">
    <div class="form-group">
      <label for="title" class="form-label">Título del servicio</label>
      <input
        type="text"
        id="title"
        name="title"
        class="form-input"
        required
      />
      <p class="form-help">Ej: Electricista a domicilio, Reparación de PC, etc.</p>
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Descripción</label>
      <textarea
        id="description"
        name="description"
        class="form-textarea"
      ></textarea>
    </div>

    <div class="form-group">
      <label for="category" class="form-label">Categoría</label>
      <input
        type="text"
        id="category"
        name="category"
        class="form-input"
        placeholder="Ej: Electricista, Plomero, Programador"
      />
    </div>

    <div class="form-group">
      <label class="form-label">Pago en dinero (opcional)</label>
      <div style="display:flex;gap:8px;">
        <input
          type="number"
          step="0.01"
          name="priceAmount"
          class="form-input"
          placeholder="Monto"
          style="flex:1;"
        />
        <input
          type="text"
          name="priceCurrency"
          class="form-input"
          placeholder="Moneda (ARS, UYU, USD...)"
          style="flex:1;"
        />
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Intercambio por horas (opcional)</label>
      <div style="display:flex;gap:8px;">
        <input
          type="number"
          step="0.5"
          name="exchangeHours"
          class="form-input"
          placeholder="Horas"
          style="flex:1;"
        />
        <input
          type="text"
          name="exchangeUnit"
          class="form-input"
          placeholder="Unidad (horas, sesiones...)"
          style="flex:1;"
        />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar servicio</button>
      <a href="/proveedores/<%= provider.id %>" class="link-muted">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
