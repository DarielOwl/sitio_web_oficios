<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Editar servicio - <%= provider.name %>
    </title>
</head>

<body>
    <h1>Editar servicio de <%= provider.name %>
    </h1>

    <% if (errorMessage) { %>
        <p style="color: red;"><strong>
                <%= errorMessage %>
            </strong></p>
        <% } %>

            <form action="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/editar" method="POST">
                <p>
                    <label for="title">Título del servicio:</label><br />
                    <input type="text" id="title" name="title" value="<%= service.title %>" required />
                </p>

                <p>
                    <label for="description">Descripción:</label><br />
                    <textarea id="description" name="description" rows="3"><%= service.description || '' %></textarea>
                </p>

                <p>
                    <label for="category">Categoría:</label><br />
                    <input type="text" id="category" name="category" value="<%= service.category || '' %>" />
                </p>

                <p>
                    <label for="priceAmount">Monto en dinero (si aplica):</label><br />
                    <input type="number" id="priceAmount" name="priceAmount" step="0.01"
                        value="<%= service.priceAmount !== null ? service.priceAmount : '' %>" />
                    <input type="text" id="priceCurrency" name="priceCurrency" placeholder="ARS"
                        value="<%= service.priceCurrency || '' %>" />
                </p>

                <p>
                    <label for="exchangeHours">Horas de intercambio (si aplica):</label><br />
                    <input type="number" id="exchangeHours" name="exchangeHours" step="0.5"
                        value="<%= service.exchangeHours !== null ? service.exchangeHours : '' %>" />
                    <input type="text" id="exchangeUnit" name="exchangeUnit" placeholder="horas"
                        value="<%= service.exchangeUnit || '' %>" />
                </p>

                <button type="submit">Guardar cambios</button>
            </form>

            <p>
                <a href="/proveedores/<%= provider.id %>">Volver al perfil del proveedor</a>
            </p>
</body>

</html>