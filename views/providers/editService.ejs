<%- include('../partials/header', { title: 'Editar servicio' }) %>

<h1 class="page-title">Editar servicio</h1>
<p class="page-subtitle">
  Actualizá la información del servicio publicado en tu perfil.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error"><%= errorMessage %></div>
  <% } %>

  <form action="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/editar" method="POST">
    <div class="form-group">
      <label for="title" class="form-label">Título del servicio</label>
      <input
        type="text"
        id="title"
        name="title"
        class="form-input"
        value="<%= service.title %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Descripción</label>
      <textarea
        id="description"
        name="description"
        class="form-textarea"
      ><%= service.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="category" class="form-label">Categoría</label>
      <input
        type="text"
        id="category"
        name="category"
        class="form-input"
        value="<%= service.category || '' %>"
      />
    </div>

    <div class="form-group">
      <label class="form-label">Pago en dinero (opcional)</label>
      <div style="display:flex;gap:8px;">
        <input
          type="number"
          step="0.01"
          name="priceAmount"
          class="form-input"
          placeholder="Monto"
          style="flex:1;"
          value="<%= service.priceAmount !== null ? service.priceAmount : '' %>"
        />
        <input
          type="text"
          name="priceCurrency"
          class="form-input"
          placeholder="Moneda"
          style="flex:1;"
          value="<%= service.priceCurrency || '' %>"
        />
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Intercambio por horas (opcional)</label>
      <div style="display:flex;gap:8px;">
        <input
          type="number"
          step="0.5"
          name="exchangeHours"
          class="form-input"
          placeholder="Horas"
          style="flex:1;"
          value="<%= service.exchangeHours !== null ? service.exchangeHours : '' %>"
        />
        <input
          type="text"
          name="exchangeUnit"
          class="form-input"
          placeholder="Unidad"
          style="flex:1;"
          value="<%= service.exchangeUnit || '' %>"
        />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
      <a href="/proveedores/<%= provider.id %>" class="link-muted">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
