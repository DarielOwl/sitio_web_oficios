<%- include('../partials/header', { title: 'Nuevo acuerdo' }) %>

<h1 class="page-title">Nuevo acuerdo con <%= provider.name %></h1>
<p class="page-subtitle">
  Registrá un acuerdo para darle seguimiento y luego dejar una reseña.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error"><%= errorMessage %></div>
  <% } %>

  <form action="/proveedores/<%= provider.id %>/acuerdos" method="POST">
    <div class="form-group">
      <label for="clientName" class="form-label">Tu nombre</label>
      <input
        type="text"
        id="clientName"
        name="clientName"
        class="form-input"
        required
      />
    </div>

    <div class="form-group">
      <label for="clientContact" class="form-label">Contacto (correo o teléfono)</label>
      <input
        type="text"
        id="clientContact"
        name="clientContact"
        class="form-input"
      />
    </div>

    <div class="form-group">
      <label for="serviceId" class="form-label">Servicio (opcional)</label>
      <select id="serviceId" name="serviceId" class="form-select">
        <option value="">-- Seleccionar servicio --</option>
        <% services.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.title %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group">
      <label for="type" class="form-label">Tipo de acuerdo</label>
      <select id="type" name="type" class="form-select">
        <option value="">Seleccionar</option>
        <option value="dinero">Dinero</option>
        <option value="horas">Intercambio de horas</option>
        <option value="mixto">Mixto</option>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label">Monto en dinero (si aplica)</label>
      <div style="display:flex;gap:8px;">
        <input
          type="number"
          step="0.01"
          name="moneyAmount"
          class="form-input"
          placeholder="Monto"
          style="flex:1;"
        />
        <input
          type="text"
          name="moneyCurrency"
          class="form-input"
          placeholder="Moneda"
          style="flex:1;"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="exchangeHours" class="form-label">Horas de intercambio (si aplica)</label>
      <input
        type="number"
        step="0.5"
        id="exchangeHours"
        name="exchangeHours"
        class="form-input"
      />
    </div>

    <div class="form-group">
      <label for="estimatedDate" class="form-label">Fecha estimada (opcional)</label>
      <input
        type="date"
        id="estimatedDate"
        name="estimatedDate"
        class="form-input"
      />
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Descripción breve del acuerdo</label>
      <textarea
        id="description"
        name="description"
        class="form-textarea"
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Crear acuerdo</button>
      <a href="/proveedores/<%= provider.id %>" class="link-muted">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
