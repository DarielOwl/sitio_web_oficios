<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Nueva reseña - <%= provider.name %>
    </title>
</head>

<body>
    <h1>Nueva reseña para <%= provider.name %>
    </h1>

    <p>
        <strong>Acuerdo:</strong>
        <% if (agreement.description) { %>
            <%= agreement.description %>
                <% } else { %>
                    (Acuerdo sin descripción)
                    <% } %>
    </p>

    <% if (errorMessage) { %>
        <p style="color: red;"><strong>
                <%= errorMessage %>
            </strong></p>
        <% } %>

            <form action="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/resenas" method="POST">
                <p>
                    <label for="rating">Calificación (1 a 5):</label><br />
                    <input type="number" id="rating" name="rating" min="1" max="5" required />
                </p>

                <p>
                    <label for="authorName">Tu nombre (opcional):</label><br />
                    <input type="text" id="authorName" name="authorName" />
                </p>

                <p>
                    <label for="comment">Comentario:</label><br />
                    <textarea id="comment" name="comment" rows="4" required></textarea>
                </p>

                <button type="submit">Enviar reseña</button>
            </form>

            <p>
                <a href="/proveedores/<%= provider.id %>">Volver al perfil del proveedor</a>
            </p>
</body>

</html>