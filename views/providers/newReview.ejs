<%- include('../partials/header', { title: 'Nueva reseña' }) %>

<h1 class="page-title">Reseña para <%= provider.name %></h1>
<p class="page-subtitle">
  Contanos cómo fue tu experiencia con este acuerdo.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error"><%= errorMessage %></div>
  <% } %>

  <div class="alert-info">
    Acuerdo con <strong><%= agreement.clientName %></strong>.
    <% if (agreement.description) { %>
      <br />
      <span class="text-sm"><%= agreement.description %></span>
    <% } %>
  </div>

  <form action="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/resenas" method="POST">
    <div class="form-group">
      <label for="rating" class="form-label">Calificación (1 a 5)</label>
      <input
        type="number"
        id="rating"
        name="rating"
        min="1"
        max="5"
        class="form-input"
        required
      />
    </div>

    <div class="form-group">
      <label for="authorName" class="form-label">Tu nombre (opcional)</label>
      <input
        type="text"
        id="authorName"
        name="authorName"
        class="form-input"
      />
    </div>

    <div class="form-group">
      <label for="comment" class="form-label">Comentario</label>
      <textarea
        id="comment"
        name="comment"
        class="form-textarea"
        required
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Publicar reseña</button>
      <a href="/proveedores/<%= provider.id %>" class="link-muted">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
