<%- include('../partials/header', { title: 'Editar perfil de proveedor' }) %>

<h1 class="page-title">Editar perfil</h1>
<p class="page-subtitle">
  Actualizá la información que se muestra en tu perfil público.
</p>

<div class="card form-card">
  <% if (errorMessage) { %>
    <div class="alert-error"><%= errorMessage %></div>
  <% } %>

  <form action="/proveedores/<%= provider.id %>/editar" method="POST">
    <div class="form-group">
      <label for="name" class="form-label">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-input"
        value="<%= provider.name %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Descripción</label>
      <textarea
        id="description"
        name="description"
        class="form-textarea"
      ><%= provider.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="experienceYears" class="form-label">Años de experiencia</label>
      <input
        type="number"
        id="experienceYears"
        name="experienceYears"
        class="form-input"
        value="<%= provider.experienceYears !== null ? provider.experienceYears : '' %>"
      />
    </div>

    <div class="form-group">
      <label for="zone" class="form-label">Zona</label>
      <input
        type="text"
        id="zone"
        name="zone"
        class="form-input"
        value="<%= provider.zone || '' %>"
      />
    </div>

    <div class="form-group">
      <label for="categories" class="form-label">Categorías</label>
      <input
        type="text"
        id="categories"
        name="categories"
        class="form-input"
        value="<%= provider.categories && provider.categories.length ? provider.categories.join(', ') : '' %>"
      />
      <p class="form-help">Separá por comas: Electricista, Plomero, Programador...</p>
    </div>

    <div class="form-group">
      <label for="whatsapp" class="form-label">WhatsApp</label>
      <input
        type="text"
        id="whatsapp"
        name="whatsapp"
        class="form-input"
        value="<%= provider.whatsapp || '' %>"
      />
    </div>

    <div class="form-group">
      <label for="email" class="form-label">Correo de contacto</label>
      <input
        type="email"
        id="email"
        name="email"
        class="form-input"
        value="<%= provider.email || '' %>"
      />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
      <a href="/proveedores/<%= provider.id %>" class="link-muted">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
