<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Editar proveedor - <%= provider.name %></title>
</head>
<body>
  <h1>Editar perfil de <%= provider.name %></h1>

  <% if (errorMessage) { %>
    <p style="color: red;"><strong><%= errorMessage %></strong></p>
  <% } %>

  <form action="/proveedores/<%= provider.id %>/editar" method="POST">
    <p>
      <label for="name">Nombre:</label><br />
      <input
        type="text"
        id="name"
        name="name"
        value="<%= provider.name || '' %>"
        required
      />
    </p>

    <p>
      <label for="description">Descripción:</label><br />
      <textarea id="description" name="description" rows="3"><%= provider.description || '' %></textarea>
    </p>

    <p>
      <label for="experienceYears">Años de experiencia:</label><br />
      <input
        type="number"
        id="experienceYears"
        name="experienceYears"
        min="0"
        value="<%= provider.experienceYears !== null && provider.experienceYears !== undefined ? provider.experienceYears : '' %>"
      />
    </p>

    <p>
      <label for="zone">Zona:</label><br />
      <input
        type="text"
        id="zone"
        name="zone"
        value="<%= provider.zone || '' %>"
      />
    </p>

    <p>
      <label for="categories">Categorías (separadas por coma):</label><br />
      <input
        type="text"
        id="categories"
        name="categories"
        value="<%= provider.categories && provider.categories.length > 0 ? provider.categories.join(', ') : '' %>"
      />
    </p>

    <p>
      <label for="whatsapp">WhatsApp (solo números o con código):</label><br />
      <input
        type="text"
        id="whatsapp"
        name="whatsapp"
        value="<%= provider.whatsapp || '' %>"
      />
    </p>

    <p>
      <label for="email">Correo electrónico:</label><br />
      <input
        type="email"
        id="email"
        name="email"
        value="<%= provider.email || '' %>"
      />
    </p>

    <button type="submit">Guardar cambios</button>
  </form>

  <p>
    <a href="/proveedores/<%= provider.id %>">Volver al perfil del proveedor</a>
  </p>
</body>
</html>
