<%- include('../partials/header', { title: 'Proveedor - ' + provider.name }) %>

<h1 class="page-title"><%= provider.name %></h1>

<p class="page-subtitle">
  <% if (ratingSummary && ratingSummary.totalReviews > 0) { %>
    Reputación: <strong><%= ratingSummary.averageRating.toFixed(1) %> / 5</strong>
    (basado en <%= ratingSummary.totalReviews %> reseñas)
  <% } else { %>
    Sin reseñas todavía.
  <% } %>
</p>

<div class="provider-layout">

  <section class="card">
    <h2 class="section-title">Información</h2>

    <% if (provider.description) { %>
      <p class="text-sm"><%= provider.description %></p>
    <% } %>

    <div class="meta-row">
      <% if (provider.zone) { %>
        <span class="meta-item">Zona: <strong><%= provider.zone %></strong></span>
      <% } %>
      <% if (provider.experienceYears) { %>
        <span class="meta-item">Experiencia: <strong><%= provider.experienceYears %> años</strong></span>
      <% } %>
    </div>

    <% if (provider.categories && provider.categories.length > 0) { %>
      <div class="meta-row">
        <% provider.categories.forEach(function (cat) { %>
          <span class="tag"><%= cat %></span>
        <% }); %>
      </div>
    <% } %>

    <div style="margin-top:16px;">
      <% if (provider.whatsapp) { %>
        <a
          href="https://wa.me/<%= provider.whatsapp.replace(/[^0-9]/g, '') %>"
          target="_blank"
          class="btn btn-primary"
        >
          Contactar por WhatsApp
        </a>
      <% } %>

      <% if (provider.email) { %>
        <a href="mailto:<%= provider.email %>" class="btn btn-ghost">
          Contactar por correo
        </a>
      <% } %>
    </div>

    <% if (currentUser && currentUser.providerId === provider.id) { %>
      <div style="margin-top:12px;">
        <a href="/proveedores/<%= provider.id %>/editar" class="link-muted">
          Editar perfil
        </a>
      </div>
    <% } %>

    <% if (currentUser && currentUser.role === 'client') { %>
      <div style="margin-top:16px;">
        <a href="/proveedores/<%= provider.id %>/acuerdos/nuevo" class="btn btn-primary">
          Registrar nuevo acuerdo
        </a>
      </div>
    <% } %>
  </section>

  <section>
    <div class="card">
      <h2 class="section-title">Servicios del proveedor</h2>

      <% if (currentUser && currentUser.providerId === provider.id) { %>
        <p class="text-sm">
          <a href="/proveedores/<%= provider.id %>/servicios/nuevo" class="btn btn-ghost">
            Agregar nuevo servicio
          </a>
        </p>
      <% } %>

      <% if (services && services.length > 0) { %>
        <ul class="list-clean">
          <% services.forEach(function (service) { %>
            <li class="list-item">
              <div class="text-sm">
                <strong><%= service.title %></strong>
              </div>

              <% if (service.description) { %>
                <div class="text-sm"><%= service.description %></div>
              <% } %>

              <div class="meta-row">
                <% if (service.category) { %>
                  <span class="meta-item">Categoría: <%= service.category %></span>
                <% } %>

                <% if (service.priceAmount !== null) { %>
                  <span class="meta-item">
                    Precio: <%= service.priceAmount %> <%= service.priceCurrency || '' %>
                  </span>
                <% } %>

                <% if (service.exchangeHours !== null) { %>
                  <span class="meta-item">
                    Intercambio: <%= service.exchangeHours %> <%= service.exchangeUnit || 'horas' %>
                  </span>
                <% } %>
              </div>

              <% if (currentUser && currentUser.providerId === provider.id) { %>
                <div class="text-xs">
                  <a
                    href="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/editar"
                    class="link-muted"
                  >
                    Editar
                  </a>
                  ·
                  <form
                    action="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/eliminar"
                    method="POST"
                    style="display:inline;"
                  >
                    <button
                      type="submit"
                      class="link-muted"
                      style="border:none;background:none;padding:0;cursor:pointer;"
                      onclick="return confirm('¿Eliminar este servicio?');"
                    >
                      Eliminar
                    </button>
                  </form>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="text-sm">Este proveedor aún no tiene servicios cargados.</p>
      <% } %>
    </div>

    <div class="card">
      <h2 class="section-title">Acuerdos registrados</h2>

      <% if (agreements && agreements.length > 0) { %>
        <ul class="list-clean">
          <% agreements.forEach(function (agreement) { %>
            <li class="list-item">
              <div class="text-sm">
                <strong>Solicitante:</strong> <%= agreement.clientName %>
              </div>

              <% if (agreement.description) { %>
                <div class="text-sm">
                  <strong>Acuerdo:</strong> <%= agreement.description %>
                </div>
              <% } %>

              <div class="meta-row">
                <% if (agreement.type) { %>
                  <span class="meta-item">Tipo: <%= agreement.type %></span>
                <% } %>

                <% if (agreement.moneyAmount !== null) { %>
                  <span class="meta-item">
                    Dinero: <%= agreement.moneyAmount %> <%= agreement.moneyCurrency || '' %>
                  </span>
                <% } %>

                <% if (agreement.exchangeHours !== null) { %>
                  <span class="meta-item">
                    Horas: <%= agreement.exchangeHours %>
                  </span>
                <% } %>

                <% if (agreement.status) { %>
                  <span class="badge-status badge-status-<%= agreement.status %>">
                    <%= agreement.status %>
                  </span>
                <% } %>
              </div>

              <% if (agreement.estimatedDate) { %>
                <div class="text-xs">
                  Fecha estimada:
                  <%= new Date(agreement.estimatedDate).toLocaleString('es-AR') %>
                </div>
              <% } %>

              <% if (currentUser && currentUser.role === 'client') { %>
                <div class="text-xs" style="margin-top:8px;">
                  <% if (agreement.status !== 'cumplido') { %>
                    <form
                      action="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/cumplir"
                      method="POST"
                      style="display:inline;"
                    >
                      <button
                        type="submit"
                        class="btn btn-ghost"
                        style="padding:4px 10px;font-size:0.8rem;"
                      >
                        Marcar como cumplido
                      </button>
                    </form>
                  <% } else { %>
                    <% if (!agreement.hasReview) { %>
                      <a
                        href="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/resenas/nueva"
                        class="btn btn-ghost"
                        style="padding:4px 10px;font-size:0.8rem;"
                      >
                        Escribir reseña
                      </a>
                    <% } else { %>
                      <span class="text-xs">Reseña registrada.</span>
                    <% } %>
                  <% } %>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="text-sm">No hay acuerdos registrados para este proveedor.</p>
      <% } %>
    </div>

    <div class="card">
      <h2 class="section-title">Reseñas</h2>

      <% if (reviews && reviews.length > 0) { %>
        <ul class="list-clean">
          <% reviews.forEach(function (review) { %>
            <li class="list-item">
              <div class="meta-row">
                <span class="meta-item">
                  Calificación: <strong><%= review.rating %> / 5</strong>
                </span>
                <% if (review.authorName) { %>
                  <span class="meta-item">Autor: <%= review.authorName %></span>
                <% } %>
              </div>

              <% if (review.comment) { %>
                <div class="text-sm"><%= review.comment %></div>
              <% } %>

              <% if (review.createdAt) { %>
                <div class="text-xs">
                  Fecha:
                  <%= new Date(review.createdAt).toLocaleString('es-AR') %>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="text-sm">Este proveedor aún no tiene reseñas.</p>
      <% } %>
    </div>
  </section>
</div>

<p class="text-sm" style="margin-top:16px;">
  <a href="/proveedores" class="link-muted">Volver al listado de proveedores</a>
</p>

<%- include('../partials/footer') %>
