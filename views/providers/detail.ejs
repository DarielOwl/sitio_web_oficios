<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>Proveedor - <%= provider.name %>
  </title>
</head>

<body>
  <h1>
    <%= provider.name %>
  </h1>

  <% if (ratingSummary && ratingSummary.totalReviews> 0) { %>
    <p>
      <strong>Reputación:</strong>
      <%= ratingSummary.averageRating.toFixed(1) %> / 5
        (basado en <%= ratingSummary.totalReviews %> reseñas)
    </p>
    <% } else { %>
      <p>
        <strong>Reputación:</strong> Sin reseñas todavía.
      </p>
      <% } %>

        <% if (provider.description) { %>
          <p>
            <strong>Descripción:</strong>
            <%= provider.description %>
          </p>
          <% } %>

            <% if (provider.experienceYears) { %>
              <p>
                <strong>Experiencia:</strong>
                <%= provider.experienceYears %> años
              </p>
              <% } %>

                <% if (provider.zone) { %>
                  <p>
                    <strong>Zona:</strong>
                    <%= provider.zone %>
                  </p>
                  <% } %>

                    <% if (provider.categories && provider.categories.length> 0) { %>
                      <p>
                        <strong>Categorías:</strong>
                        <%= provider.categories.join(', ') %>
    </p>
  <% } %>

  <p>
    <a href="/proveedores/<%= provider.id %>/acuerdos/nuevo">
      Registrar nuevo acuerdo
    </a>
  </p>

  <p>
    <% if (provider.whatsapp) { %>
      <strong>WhatsApp:</strong>
      <a href="https://wa.me/<%= provider.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank">
        Contactar por WhatsApp
      </a>
      <br />
    <% } %>

    <% if (provider.email) { %>
      <strong>Correo:</strong>
      <a href="mailto:<%= provider.email %>">
        Contactar por correo
      </a>
    <% } %>
  </p>

  <hr />

  <section>
    <h2>Servicios del proveedor</h2>

    <p>
      <a href="/proveedores/<%= provider.id %>/servicios/nuevo">
        Agregar nuevo servicio
      </a>
    </p>

    <% if (services && services.length > 0) { %>
      <ul>
        <% services.forEach(function (service) { %>
          <li>
            <strong><%= service.title %></strong><br />

            <% if (service.description) { %>
              <span><%= service.description %></span><br />
            <% } %>

            <% if (service.category) { %>
              <span>Categoría: <%= service.category %></span><br />
            <% } %>

            <% if (service.priceAmount !== null) { %>
              <span>
                Precio: <%= service.priceAmount %> <%= service.priceCurrency || '' %>
              </span><br />
            <% } %>

            <% if (service.exchangeHours !== null) { %>
              <span>
                Intercambio: <%= service.exchangeHours %> <%= service.exchangeUnit || ' horas' %>
                          </span><br />
                          <% } %>

                            <a href="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/editar">
                              Editar
                            </a>

                            <form action="/proveedores/<%= provider.id %>/servicios/<%= service.id %>/eliminar"
                              method="POST" style="display: inline;">
                              <button type="submit" onclick="return confirm('¿Eliminar este servicio?');">
                                Eliminar
                              </button>
                            </form>
                            </li>
                            <hr />
                            <% }); %>
                              </ul>
                              <% } else { %>
                                <p>Este proveedor aún no tiene servicios cargados.</p>
                                <% } %>
                                  </section>

                                  <section>
                                    <h2>Acuerdos registrados</h2>

                                    <% if (agreements && agreements.length> 0) { %>
                                      <ul>
                                        <% agreements.forEach(function (agreement) { %>
                                          <li>
                                            <strong>Solicitante:</strong>
                                            <%= agreement.clientName %><br />

                                              <% if (agreement.type) { %>
                                                <strong>Tipo:</strong>
                                                <%= agreement.type %><br />
                                                  <% } %>

                                                    <% if (agreement.moneyAmount !==null) { %>
                                                      <strong>Dinero:</strong>
                                                      <%= agreement.moneyAmount %>
                                                        <%= agreement.moneyCurrency || '' %><br />
                                                          <% } %>

                                                            <% if (agreement.exchangeHours !==null) { %>
                                                              <strong>Horas:</strong>
                                                              <%= agreement.exchangeHours %><br />
                                                                <% } %>

                                                                  <% if (agreement.description) { %>
                                                                    <strong>Descripción:</strong>
                                                                    <%= agreement.description %><br />
                                                                      <% } %>

                                                                        <% if (agreement.status) { %>
                                                                          <strong>Estado:</strong>
                                                                          <%= agreement.status %><br />
                                                                            <% } %>

                                                                              <% if (agreement.estimatedDate) { %>
                                                                                <small>
                                                                                  Fecha estimada:
                                                                                  <%= new
                                                                                    Date(agreement.estimatedDate).toLocaleString('es-AR')
                                                                                    %>
                                                                                </small><br />
                                                                                <% } %>

                                                                                  <% if (agreement.status !=='cumplido'
                                                                                    ) { %>
                                                                                    <form
                                                                                      action="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/cumplir"
                                                                                      method="POST"
                                                                                      style="display: inline;">
                                                                                      <button type="submit">Marcar como
                                                                                        cumplido</button>
                                                                                    </form>
                                                                                    <% } else { %>
                                                                                      <% if (!agreement.hasReview) { %>
                                                                                        <a
                                                                                          href="/proveedores/<%= provider.id %>/acuerdos/<%= agreement.id %>/resenas/nueva">
                                                                                          Escribir reseña
                                                                                        </a>
                                                                                        <% } else { %>
                                                                                          <span>Reseña
                                                                                            registrada.</span>
                                                                                          <% } %>
                                                                                            <% } %>
                                          </li>
                                          <hr />
                                          <% }); %>
                                      </ul>
                                      <% } else { %>
                                        <p>No hay acuerdos registrados para este proveedor.</p>
                                        <% } %>
                                  </section>

                                  <section>
                                    <h2>Reseñas</h2>

                                    <% if (reviews && reviews.length> 0) { %>
                                      <ul>
                                        <% reviews.forEach(function (review) { %>
                                          <li>
                                            <strong>Calificación:</strong>
                                            <%= review.rating %> / 5<br />

                                              <% if (review.authorName) { %>
                                                <strong>Autor:</strong>
                                                <%= review.authorName %><br />
                                                  <% } %>

                                                    <% if (review.comment) { %>
                                                      <strong>Comentario:</strong>
                                                      <%= review.comment %><br />
                                                        <% } %>

                                                          <% if (review.createdAt) { %>
                                                            <small>
                                                              Fecha:
                                                              <%= new Date(review.createdAt).toLocaleString('es-AR') %>
                                                            </small>
                                                            <% } %>
                                          </li>
                                          <hr />
                                          <% }); %>
                                      </ul>
                                      <% } else { %>
                                        <p>Este proveedor aún no tiene reseñas.</p>
                                        <% } %>
                                  </section>

                                  <p>
                                    <a href="/proveedores">Volver al listado de proveedores</a>
                                  </p>
</body>

</html>