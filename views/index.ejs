<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Oficios locales</title>
    <!-- ojo: SIN /public -->
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-slate-50 min-h-screen">

    <!-- navbar -->
    <%- include('partials/navbar') %>

    <main class="max-w-6xl mx-auto py-10 space-y-8">
      <!-- bloque de búsqueda -->
      <section class="bg-white rounded-xl shadow p-6">
        <h1 class="text-2xl font-bold mb-4">Encuentra profesionales cerca de ti</h1>
        <form action="/buscar" method="GET" class="flex gap-3">
          <input
            type="text"
            name="q"
            placeholder="Nombre o servicio..."
            class="border rounded px-3 py-2 flex-1"
          />
          <button class="bg-blue-600 text-white px-5 py-2 rounded">Buscar</button>
        </form>
      </section>

      <!-- listado -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold">Proveedores encontrados</h2>

        <% if (proveedores && proveedores.length) { %>
          <div class="grid md:grid-cols-2 gap-4">
            <% proveedores.forEach(p => { %>
              <article class="bg-white rounded-lg shadow p-4 space-y-2">
                <h3 class="text-base font-bold"><%= p.nombre %></h3>
                <p class="text-sm text-slate-500"><%= p.zona || 'Zona no especificada' %></p>
                <p class="text-sm"><%= p.descripcion || 'Sin descripción' %></p>
                <div class="flex gap-2 mt-2">
                  <a href="/proveedor/dashboard" class="text-sm bg-slate-900 text-white px-3 py-1 rounded">Ver perfil</a>
                  <% if (p.contacto && p.contacto.whatsapp) { %>
                    <a href="https://wa.me/<%= p.contacto.whatsapp %>" target="_blank" class="text-sm bg-green-500 text-white px-3 py-1 rounded">WA</a>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-slate-500 text-sm">No hay proveedores cargados todavía.</p>
        <% } %>
      </section>
    </main>
  </body>
</html>
