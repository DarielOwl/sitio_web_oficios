<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Oficios locales</title>
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="bg-slate-50 min-h-screen">
    <%- include('partials/navbar') %>

    <main class="max-w-6xl mx-auto py-10 space-y-8">
      <section class="bg-white rounded-xl shadow p-6 flex flex-col gap-3">
        <h1 class="text-2xl font-bold text-slate-900">Encuentra profesionales cerca de ti</h1>
        <p class="text-slate-500 text-sm">Paga con dinero o intercambia servicios.</p>
        <form action="/buscar" method="GET" class="flex gap-3">
          <input
            type="text"
            name="q"
            placeholder="Nombre o servicio..."
            class="border rounded px-3 py-2 flex-1"
          />
          <button class="bg-blue-600 text-white px-5 py-2 rounded">Buscar</button>
        </form>
      </section>

      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-slate-900">Proveedores encontrados</h2>

        <% if (proveedores && proveedores.length) { %>
          <div class="grid md:grid-cols-2 gap-4">
            <% proveedores.forEach(p => { %>
              <article class="bg-white rounded-lg shadow p-4 space-y-3">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-base font-bold text-slate-900"><%= p.nombre %></h3>
                    <p class="text-sm text-slate-500"><%= p.oficio || p.categoria || 'Oficio' %></p>
                    <p class="text-xs text-slate-400 flex items-center gap-1">
                      <span>⭐ <%= p.rating || '4.5' %></span>
                      <span class="text-slate-400">(<%= p.totalResenas || 0 %> reseñas)</span>
                      <% if (p.zona) { %>
                        <span>· <%= p.zona %></span>
                      <% } %>
                    </p>
                  </div>
                  <% if (p.aceptaTrueque) { %>
                    <span class="text-xs bg-blue-50 text-blue-600 px-2 py-1 rounded-full">Acepta trueque</span>
                  <% } %>
                </div>

                <div>
                  <% if (p.precioMin && p.precioMax) { %>
                    <p class="text-emerald-600 font-semibold text-sm">
                      $<%= p.precioMin %> - $<%= p.precioMax %>
                    </p>
                  <% } else { %>
                    <p class="text-slate-400 text-sm">Consultar precio</p>
                  <% } %>
                </div>

                <% if (p.etiquetas && p.etiquetas.length) { %>
                  <div class="flex flex-wrap gap-2">
                    <% p.etiquetas.forEach(tag => { %>
                      <span class="bg-slate-100 text-slate-700 text-xs px-2 py-1 rounded"><%= tag %></span>
                    <% }) %>
                  </div>
                <% } %>

                <div class="flex flex-wrap gap-2 pt-2">
                  <a href="/proveedor/dashboard" class="bg-slate-900 text-white text-sm px-4 py-2 rounded">
                    Ver perfil
                  </a>
                  <% if (p.contacto && p.contacto.whatsapp) { %>
                    <a href="https://wa.me/<%= p.contacto.whatsapp %>" target="_blank"
                      class="bg-green-500 text-white text-sm px-4 py-2 rounded">
                      WA
                    </a>
                  <% } %>
                  <% if (p.contacto && p.contacto.email) { %>
                    <a href="mailto:<%= p.contacto.email %>" class="border text-sm px-4 py-2 rounded">
                      Contactar
                    </a>
                  <% } %>
                  <% if (p.aceptaTrueque) { %>
                    <button class="border border-blue-500 text-blue-500 text-sm px-4 py-2 rounded">
                      Trueque
                    </button>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-slate-500 text-sm">No hay proveedores cargados todavía.</p>
        <% } %>
      </section>
    </main>
  </body>
</html>
